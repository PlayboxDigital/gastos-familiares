# .env.example
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_UPLOAD_PRESET=

# OCR inteligente:
# GEMINI_API_KEY se configura exclusivamente como secreto de Supabase Edge Functions.
# CLOUDINARY_CLOUD_NAME debe configurarse en la función para validar el origen de las imágenes.
# Opcional: GEMINI_MODEL permite cambiar el modelo (por defecto: gemini-3.6-flash).
# No crear VITE_GEMINI_API_KEY ni guardar aquí una clave real.
